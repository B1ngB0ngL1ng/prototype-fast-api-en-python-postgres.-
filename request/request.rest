# =====================================================================
# CONCRETE WAREHOUSE-CRUD VOORBEELDEN
# =====================================================================
# Controleer de kolomnamen in GET /warehouses voordat je dit gebruikt.
# Deze payload volgt de oorspronkelijke CargoHub warehouse-velden.
# Een ID 999002 mag niet al bestaan.
# Gebruik alleen als de database dit schema ondersteunt.

### CREATE test warehouse — 201 verwacht
# POST {{baseUrl}}/warehouses
# API_KEY: {{apiKey}}
# Content-Type: application/json
#
# {
#   "id": 999002,
#   "code": "TEST-RTM-999002",
#   "name": "Test Warehouse",
#   "address": "Teststraat 1",
#   "city": "Rotterdam",
#   "zip_code": "3000 AA",
#   "province": "Zuid-Holland",
#   "country": "Netherlands",
#   "contact_name": "Test Persoon",
#   "contact_phone": "0612345678",
#   "contact_email": "test@example.com"
# }

### READ aangemaakt warehouse
GET {{baseUrl}}/warehouses/{{warehouseTestId}}
API_KEY: {{apiKey}}

### UPDATE test warehouse — 200 verwacht
# PUT {{baseUrl}}/warehouses/{{warehouseTestId}}
# API_KEY: {{apiKey}}
# Content-Type: application/json
#
